# Local API settings (placeholders only; never commit real credentials)
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=24
SESSION_COOKIE_SECURE=false

# Backend and integration configuration
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>
REDIS_URL=redis://<host>:6379/0
# Optional host ports for local compose services when defaults are occupied.
# Set POSTGRES_HOST_PORT or REDIS_HOST_PORT in the shell or local `.env` before Compose starts.
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
GITHUB_APP_ID=<github-app-id>
GITHUB_APP_SLUG=<github-app-slug>
GITHUB_CLIENT_ID=<github-client-id>
GITHUB_CLIENT_SECRET=<server-side-client-secret>
GITHUB_CALLBACK_URL=<public-api-github-callback-url>
GITHUB_PRIVATE_KEY_PATH=<server-side-private-key-path>
GITHUB_WEBHOOK_SECRET=<webhook-secret>
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_API_KEY=<server-side-api-key>
NEBIUS_MODEL=<exact-model-id-enabled-for-your-key>
NEBIUS_INPUT_PRICE_PER_MILLION=<optional-input-price>
NEBIUS_OUTPUT_PRICE_PER_MILLION=<optional-output-price>
# Millisa OpenAI-compatible gateway: used for Coder calls when a key is configured.
MILLISA_BASE_URL=https://millisa.codly.in/api/v1
MILLISA_API_KEY=<server-side-millisa-key>
MILLISA_MODEL=millisa-auto
VALIDATION_DOCKER_BIN=docker
VALIDATION_IMAGE=<trusted-image-with-python-3-and-pytest>
VALIDATION_TIMEOUT_SECONDS=300
VALIDATION_MEMORY_LIMIT=2g
VALIDATION_CPU_LIMIT=2
VALIDATION_WORKSPACE_LIMIT=512m
VALIDATION_TEMP_LIMIT=256m
MILISA_FIX_TTL_DAYS=365
REPAIR_CONCURRENCY_PER_ORG=1
REPAIR_SLOT_LEASE_SECONDS=120
REPAIR_QUEUE_WAIT_SECONDS=30
REPAIR_JOB_TIMEOUT_SECONDS=1800
